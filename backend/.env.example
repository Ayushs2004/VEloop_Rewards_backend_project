# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# For local MongoDB installation or MongoDB Atlas:
MONGO_URI=mongodb://localhost:27017/veloop_wallet_demo
# Set to 'true' to automatically use an embedded in-memory MongoDB runner if no local MongoDB service is running
USE_IN_MEMORY_DB=false

# Authentication
JWT_SECRET=veloop_super_secret_jwt_key_2026_demo_secure!
JWT_EXPIRES_IN=7d

# CORS Client URL
CLIENT_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=20
WITHDRAWAL_RATE_LIMIT_MAX=15
